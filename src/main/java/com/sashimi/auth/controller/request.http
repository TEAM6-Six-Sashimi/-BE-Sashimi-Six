Accept: application/json

{
  "refreshToken": "eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiJzdHVkZW50MDEiLCJpYXQiOjE3Nzk4NjgwMTQsImV4cCI6MTc4MTA3NzYxNH0.fPa-yKIiImpg3Cif08Z1FrDunxvjcs5-yMV2OUWtzZi4mt4xwgS7jQnnQNeOJswK"
